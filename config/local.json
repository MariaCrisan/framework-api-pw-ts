{
  "baseUrl": "https://postman-echo.com",
  "apiVersion": "",
  "timeout": 15000,
  "verifySsl": true,
  "endpoints": {
    "health": "/get?health=ok",
    "login": "/__replace-with-login-endpoint__",
    "protectedResource": "/__replace-with-protected-endpoint__"
  },
  "auth": {
    "tokenField": "accessToken",
    "tokenType": "Bearer",
    "enabled": false
  }
}
