{
  "name": "playwright-api-test-framework",
  "version": "1.0.0",
  "private": true,
  "description": "A composable TypeScript and Playwright API test framework skeleton.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:auth": "playwright test --grep @auth",
    "test:health": "playwright test --grep @health",
    "test:report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.5",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.7.2"
  }
}
